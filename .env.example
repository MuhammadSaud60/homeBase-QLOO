# HomeBase — environment variables (copy to .env, never commit the real file)
# Qloo Taste AI API key (hackathon key, works against https://hackathon.api.qloo.com)
QLOO_API_KEY=
# Google Gemini API key (free tier) for first-month narration
GEMINI_API_KEY=
# Gemini model (optional, default gemini-2.5-flash — 2.0-flash is shut down)
GEMINI_MODEL=gemini-2.5-flash
# Port (Render sets this automatically)
PORT=3000
